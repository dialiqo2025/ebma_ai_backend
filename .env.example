PORT=5002

DATABASE_HOST=
DATABASE_PORT=22897
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASS=
DATABASE_SSL=true

JWT_SECRET_KEY=

# Email delivery. "auto" uses Resend when RESEND_API_KEY is set, otherwise SMTP.
# Render free web services block SMTP ports, so use Resend there (HTTPS/port 443).
EMAIL_PROVIDER=auto
EMAIL_TIMEOUT_MS=15000
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="ebma AI <contact@ebma.ai>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ebma AI <no-reply@example.com>"
# Receives Contact Us and custom-pricing inquiries.
CUSTOM_PRICING_TO_EMAIL=hello@ebma.ai
# Daily CSV report recipient. Falls back to CUSTOM_PRICING_TO_EMAIL when empty.
DAILY_USER_REPORT_TO_EMAIL=
DAILY_USER_REPORT_TIMEZONE=Asia/Kolkata

# Send an email even when the report contains zero users.
DAILY_USER_REPORT_SEND_EMPTY=false
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
CONTACT_MIN_INTERVAL_SECONDS=15

OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

LOGIN_URL=http://localhost:3000/auth

# TTS model integration. Keep auto-processing false while the GPU is offline.
# Use the full POST synthesize URL, e.g. https://<host>/tts/v1/audio/speech
TTS_AUTO_PROCESS=false
TTS_MODEL_ENDPOINT=
# Optional dedicated health URL. When omitted, the backend sends an OPTIONS
# request to TTS_MODEL_ENDPOINT as a non-generating reachability probe.
TTS_MODEL_HEALTH_ENDPOINT=
TTS_MODEL_HEALTH_TIMEOUT_MS=10000
TTS_MODEL_API_KEY=
TTS_MODEL_API_KEY_HEADER=Authorization
TTS_MODEL_API_KEY_PREFIX=Bearer
TTS_MODEL_TIMEOUT_MS=60000
TTS_MODEL_TEMPERATURE=0.8
TTS_MODEL_TOP_K=50
TTS_MAX_AUDIO_BYTES=26214400
TTS_AUDIO_DIRECTORY=storage/tts
# Streaming TTS (stream: true → raw PCM). Match GPU portal sample rate if audio sounds wrong.
TTS_STREAM_SAMPLE_RATE=24000
TTS_STREAM_CHANNELS=1

# LLM fallback for transcript cleanup and voice assistant chat (/api/v1/chat).
# Translate uses the user's Custom self-hosted endpoint from LLM settings and will
# not fall back to a third-party provider.
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
LLM_API_KEY=
LLM_API_KEY_HEADER=x-goog-api-key
LLM_API_KEY_PREFIX=
LLM_TIMEOUT_MS=30000
# Optional (Gemini 2.5 Flash): 0 disables "thinking" for faster replies.
LLM_THINKING_BUDGET=0

# EBMA ASR/STT GPU backend. These secrets stay on this server.
# Indic HTTP/WS host root only (e.g. https://gpu.example.com) — no /health and no ?key=.
EBMA_ASR_BACKEND_URL=
EBMA_ASR_API_KEY=
# Arabic live + file WebSocket base (no query). Example: wss://gpu.example.com/ar/ws
# Live and file sessions both connect from the browser and append a short-lived ?token=.
EBMA_ASR_ARABIC_WS_URL=
# Optional override for Arabic health (default: derived from EBMA_ASR_ARABIC_WS_URL → /ar/health).
EBMA_ASR_ARABIC_HEALTH_URL=
EBMA_ASR_TIMEOUT_MS=10000
EBMA_ASR_UPLOAD_TIMEOUT_MS=300000
STT_MAX_UPLOAD_BYTES=314572800
STT_TOKEN_RATE_LIMIT=5
STT_TOKEN_RATE_WINDOW_SECONDS=60

# Billing credits: one credit per native usage unit
BILLING_TTS_CREDITS_PER_CHARACTER=1
BILLING_STT_CREDITS_PER_SECOND=1
BILLING_LLM_CREDITS_PER_TOKEN=1
# 1 wallet credit = ₹1. PAYG plan rates (TTS ₹/1000 chars, STT ₹/min) live on billing_plans.

# Stripe checkout (keep secret key and webhook secret server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=INR
# Comma-separated Stripe Checkout methods (e.g. card or card,upi)
STRIPE_PAYMENT_METHOD_TYPES=card
FRONTEND_URL=http://localhost:3000
# Marketing site origin (CORS + playground origin allowlist)
SITE_URL=http://localhost:3001
# Optional comma-separated extra CORS origins
# CORS_ORIGINS=https://ebma.ai,https://www.ebma.ai

# Public website playground trials (GPU stays private; only this API calls it)
PLAYGROUND_TRIAL_LIMIT=5
PLAYGROUND_TTS_MAX_CHARS=200
PLAYGROUND_STT_MAX_BYTES=1500000
PLAYGROUND_RATE_LIMIT=6
PLAYGROUND_RATE_WINDOW_SECONDS=60
PLAYGROUND_MIN_INTERVAL_MS=5000
PLAYGROUND_GLOBAL_CONCURRENCY=2
PLAYGROUND_ALLOWED_ORIGINS=http://localhost:3001
PLAYGROUND_PORTAL_LOGIN_URL=http://localhost:3000
# Optional dedicated salt for hashing trial IPs (falls back to JWT secret)
# PLAYGROUND_IP_SALT=

# Razorpay Payment Links (optional second provider; INR one-time checkout)
# Dashboard → Webhooks → URL: https://<api-host>/api/v1/billing/webhook/razorpay
# Events: payment_link.paid, payment.captured (credits wallet even if browser never returns)
# FRONTEND_URL must match the user app (callback lands on /platform/billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
# Comma-separated Razorpay hosted methods (upi,card,netbanking,wallet,emi,paylater)
RAZORPAY_PAYMENT_METHODS=upi,card,netbanking

# Signup: require work email for *new* accounts (existing personal emails can still sign in)
# SIGNUP_REQUIRE_WORK_EMAIL=true
# Comma-separated extras to block (merged with built-in free/disposable list)
# SIGNUP_BLOCKED_EMAIL_DOMAINS=example-temp.com,another-free.net
# Optional allowlist that always passes even if otherwise blocked
# SIGNUP_ALLOWED_EMAIL_DOMAINS=

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback
CLIENT_OAUTH_REDIRECT=http://localhost:3000/oauth-success
FRONTEND_URL=http://localhost:3000

# Microsoft OAuth (Azure portal → App registrations)
# Redirect URI: http://localhost:5001/api/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:5001/api/v1/auth/microsoft/callback

# Apple Sign In (developer.apple.com → Identifiers / Keys)
# Return URL: http://localhost:5001/api/v1/auth/apple/callback
# APPLE_CLIENT_ID is your Services ID (e.g. com.ebma.web)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste .p8 key contents; use \n for newlines in a single line
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/apple/callback
